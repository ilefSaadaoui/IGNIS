# ==============================================================================
# IGNIS — Space Combustion Intelligence
# Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in `backend/ignis_adk/.env`:
#   cp .env.example backend/ignis_adk/.env
#
# IMPORTANT: NEVER commit the actual `.env` file containing real secret keys!
# ==============================================================================

# --- Primary Provider: Google Gemini (Recommended — matches NASA presentation) ---
# Get your free API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# --- Secondary / Fallback Provider: Groq (Optional) ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/openai/gpt-oss-20b
GROQ_REASONING_MODEL=groq/openai/gpt-oss-20b
GROQ_FAST_MODEL=groq/openai/gpt-oss-20b
GROQ_VISION_MODEL=groq/openai/gpt-oss-20b

# --- Provider Priority Order ---
# Supported: gemini, groq, openrouter (comma-separated, evaluated left to right)
IGNIS_PROVIDER_ORDER=gemini,groq

# --- NASA Open Data APIs ---
# Get your free NASA API key at: https://api.nasa.gov/
NASA_API_KEY=your_nasa_api_key_here
NASA_REQUEST_TIMEOUT=5
NASA_MAX_RESULTS=5
NASA_CACHE_TTL_SECONDS=300

# --- CORE Academic Research API (Optional) ---
# Get your key at: https://core.ac.uk/services/api
CORE_API_KEY=your_core_api_key_here
CORE_REQUEST_TIMEOUT=10
CORE_MAX_RESULTS=5

# --- Token & Context Budgets ---
MAX_INPUT_TOKENS=3500
MAX_OUTPUT_TOKENS=2048
MAX_CONTEXT_TOKENS=128000
MAX_AGENT_ITERATIONS=3
MAX_CONVERSATION_HISTORY=6
MAX_DOCUMENT_CHARS=10000
MAX_AGENT_OUTPUT_CHARS=4000

# --- Execution Controls ---
REQUEST_TIMEOUT=60
MAX_RETRIES=2
LOG_LEVEL=INFO

# --- Dense Embeddings Mode (RAG Hybrid Retrieval) ---
# Options: 'on' (hybrid TF-IDF + all-MiniLM-L6-v2, default), 'off' (TF-IDF only)
IGNIS_DENSE=on
IGNIS_DENSE_WEIGHT=0.6
